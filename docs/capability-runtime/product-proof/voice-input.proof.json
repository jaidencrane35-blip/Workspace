{
  "schemaVersion": 2,
  "provider": "voice_input",
  "program": "P16",
  "kind": "conversation_input_device",
  "pipeline": [
    "Microphone",
    "VoicePort",
    "Conversation composer",
    "Intent Layer",
    "execute_capability_intent",
    "Kernel Operator",
    "Capability Runtime",
    "Providers",
    "Operating System",
    "Conversation Response"
  ],
  "ipc": {
    "voice": [
      "voice_status",
      "voice_warm_up",
      "voice_recheck_permission",
      "voice_listen_once",
      "voice_cancel",
      "voice_open_settings"
    ],
    "desktop": "execute_capability_intent"
  },
  "responsiveness": {
    "prewarm": true,
    "listeningIndicatorOnlyWhenCapturing": true,
    "gateListeningOnWinrtCapturingState": true,
    "noStatusRoundTripBeforeListen": true,
    "hoistedListeningEventSubscription": true,
    "warmBeforeListenWhenCold": true,
    "soundStartedActivity": true,
    "firstWordCapture": "required",
    "continuousRecognitionSession": true,
    "conversationContinuity": true,
    "autoStopSilenceTimeoutSeconds": 10,
    "micToggleFinalizesTranscript": true,
    "sessionStitchingFiveMinutes": true,
    "readyOnlyOnCapturing": true,
    "listeningOnlyOnSpeechDetected": true,
    "permissionGuidanceNoAutoSettings": true,
    "permissionRecheckAfterSettingsReturn": true,
    "rememberGrantedNeverReopenSettings": true,
    "settleBeforeReadyMs": 45,
    "permissionStateMachineOncePerDenyCycle": true,
    "spawnBlockingListenAndWarm": true,
    "statusPeekOnly": true
  },
  "uiPhases": [
    "idle",
    "preparing",
    "ready",
    "speechDetected",
    "listening",
    "recognizing",
    "processing",
    "finished"
  ],
  "lifecycleEvidence": [
    "voice.lifecycle: warm_done",
    "voice.lifecycle: continuous_started",
    "voice.lifecycle: capturing_contract",
    "voice.lifecycle: on_ready_emitted",
    "voice.lifecycle: speech_detected",
    "voice.lifecycle: stitch_resume",
    "voice.lifecycle: continuous_complete",
    "voice.lifecycle: permission_recheck_begin",
    "voice.lifecycle: permission_recheck_done",
    "voice.lifecycle: mic_probe_begin"
  ],
  "userLanguageRules": [
    "Never expose Provider, Router, Registry, Runtime, Kernel, WinRT, or SpeechRecognizer terminology",
    "Never invent transcripts",
    "Voice behaves exactly like typing after recognition",
    "Capability Independence — desktop language only",
    "Never expose HRESULT, stack traces, or raw OS exception text",
    "Conversation Continuity — never end listening on short mid-speech silence"
  ],
  "failureModes": [
    {
      "id": "windows_speech_privacy",
      "osCode": "0x80045509",
      "status": "permission_denied",
      "mustMention": ["speech privacy", "Settings"],
      "mustNotMention": ["0x", "WinRT", "SpeechRecognizer", "recognize:"]
    },
    {
      "id": "microphone_unavailable",
      "status": "microphone_unavailable"
    },
    {
      "id": "recognition_unavailable",
      "status": "recognition_unavailable"
    }
  ],
  "windowsPrerequisites": [
    "Online speech recognition / speech privacy accepted in Windows Settings",
    "Microphone connected and allowed for Workspace"
  ],
  "examples": [
    {
      "category": "status",
      "utterance": "Can you hear me?",
      "expectedKind": "voiceStatus"
    },
    {
      "category": "status",
      "utterance": "Is voice available?",
      "expectedKind": "voiceStatus"
    },
    {
      "category": "explain",
      "utterance": "What can you do with voice?",
      "expectedKind": "voiceExplain"
    },
    {
      "category": "typed_equivalence",
      "utterance": "Open ChatGPT.",
      "expectedKind": "browserOpen",
      "expectedDomain": "browser",
      "note": "Same Intent path Voice will submit after recognition"
    },
    {
      "category": "typed_equivalence",
      "utterance": "Open a new GPT tab",
      "expectedKind": "browserOpen",
      "expectedDomain": "browser",
      "note": "Must not launch gpt tab.exe — browser alias"
    },
    {
      "category": "typed_equivalence",
      "utterance": "Open GPT in a new tab",
      "expectedKind": "browserOpen",
      "expectedDomain": "browser"
    },
    {
      "category": "typed_equivalence",
      "utterance": "Take a screenshot.",
      "expectedKind": "screenshotDesktop",
      "expectedDomain": "screenshots"
    },
    {
      "category": "typed_equivalence",
      "utterance": "Bring Chrome to the front.",
      "expectedKind": "winFocus",
      "expectedDomain": "window"
    },
    {
      "category": "typed_equivalence",
      "utterance": "Open GitHub beside Cursor.",
      "expectedKind": "browserOpenBeside",
      "expectedDomain": "browser"
    },
    {
      "category": "typed_equivalence",
      "utterance": "Take a screenshot and copy it.",
      "expectedKind": "screenshotCaptureAndCopy",
      "expectedDomain": "screenshots"
    },
    {
      "category": "typed_equivalence",
      "utterance": "Copy this screenshot.",
      "expectedKind": "screenshotCopy",
      "expectedDomain": "screenshots"
    },
    {
      "category": "typed_equivalence",
      "utterance": "Open my browser.",
      "expectedKind": "browserOpen",
      "expectedDomain": "browser"
    },
    {
      "category": "typed_equivalence",
      "utterance": "Could you take a screenshot?",
      "expectedKind": "screenshotDesktop",
      "expectedDomain": "screenshots",
      "note": "Polite ordinary phrasing — User Adaptation Prohibition"
    },
    {
      "category": "conversation_quality",
      "utterance": "Testing testing 123",
      "expectedKind": "unknown",
      "note": "Mic check — acknowledge hearing; not mechanical fallback"
    },
    {
      "category": "conversation_quality",
      "utterance": "What windows are open?",
      "expectedKind": "winEnumerate",
      "expectedDomain": "window"
    }
  ],
  "conversationQuality": {
    "program": "P16.6",
    "userAdaptationProhibition": true,
    "variedUnsupportedGuidance": true,
    "voiceCheckAcknowledgement": true
  },
  "uiRequirements": [
    "op-shell__mic",
    "VoiceMicButton",
    "listening indicator",
    "composer integration",
    "data-preparing",
    "warmUpVoice"
  ],
  "independenceRule": true,
  "compositionAudit": "docs/capability-runtime/product-proof/VOICE_INPUT_COMPOSITION_AUDIT.md"
}
